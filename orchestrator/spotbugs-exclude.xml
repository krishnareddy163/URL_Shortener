<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reviewed SpotBugs/FindSecBugs suppressions. Each entry is scoped to specific classes and bug patterns
  and carries its justification. Everything not listed here fails the build.
-->
<FindBugsFilter>
  <!--
    Engine collaborators are shared, intentionally mutable service objects passed by constructor injection
    (event log, workspace, artifact store, safe-stop monitor, the build runner shared by the build gates, ...); Orchestrator and Engine hand them out. Defensive copies would break the design.
    Data records (Artifact, Proposal, ...) are NOT excluded; they make immutable copies.
  -->
  <Match>
    <Or>
      <Class name="com.example.agentic.core.Orchestrator"/>
      <Class name="com.example.agentic.core.engine.Engine"/>
      <Class name="com.example.agentic.core.engine.ArtifactRecorder"/>
      <Class name="com.example.agentic.core.engine.GateRunner"/>
      <Class name="com.example.agentic.core.engine.NodeCompletion"/>
      <Class name="com.example.agentic.core.engine.ReplanService"/>
      <Class name="com.example.agentic.core.engine.SafeStop"/>
      <Class name="com.example.agentic.core.engine.Scheduler"/>
      <Class name="com.example.agentic.core.engine.NodeRunner"/>
      <Class name="com.example.agentic.core.approval.ApprovalService"/>
      <Class name="com.example.agentic.core.approval.ClarificationService"/>
      <Class name="com.example.agentic.core.state.RunLog"/>
      <Class name="com.example.agentic.core.report.LineageWalker"/>
      <Class name="com.example.agentic.core.gate.MavenGate"/>
      <Class name="com.example.agentic.core.gate.ReproducesDefectGate"/>
      <Class name="com.example.agentic.core.gate.TestCoverageGate"/>
    </Or>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>
  <!--
    BuildRunner exists to execute the build tool on staged code (R10). The executable comes from the
    operator-owned policy file and is validated against [A-Za-z0-9._/-]+, arguments are fixed by the
    gate, no shell is involved, the environment is stripped to an allowlist, and a timeout kills the tree.
  -->
  <Match>
    <Class name="com.example.agentic.core.gate.BuildRunner"/>
    <Bug pattern="COMMAND_INJECTION"/>
  </Match>
  <!--
    GitHistory runs the fixed executable "git" with no shell, fixed subcommands, and workspace paths that PathGuard
    has already validated, always after the end-of-options marker; the environment is stripped and git's global and system configuration
    are disabled, and every call has a timeout.
  -->
  <Match>
    <Class name="com.example.agentic.core.workspace.GitHistory"/>
    <Bug pattern="COMMAND_INJECTION"/>
  </Match>
  <!-- FailureSignature normalizes text only to hash it; no validation decision is made on the string. -->
  <Match>
    <Class name="com.example.agentic.core.gate.FailureSignature"/>
    <Bug pattern="MODIFICATION_AFTER_VALIDATION"/>
  </Match>
  <!--
    MermaidRenderer emits Markdown/Mermaid, not XML. Node ids are validated ([a-z][a-z0-9_]*), agent ids
    must be registered, and label text is entity-escaped.
  -->
  <Match>
    <Class name="com.example.agentic.core.report.MermaidRenderer"/>
    <Bug pattern="POTENTIAL_XML_INJECTION"/>
  </Match>
</FindBugsFilter>
