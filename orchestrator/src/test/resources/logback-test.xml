<configuration>
  <!--
    Same as the main configuration, except that loggers whose warnings are produced on purpose by negative tests
    (BuildRunnerTest's timeout) log only errors. Any other warning still shows in test output.
  -->
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} - %msg%n</pattern>
    </encoder>
  </appender>
  <logger name="com.example.agentic.core.gate.BuildRunner" level="ERROR"/>
  <root level="WARN">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
