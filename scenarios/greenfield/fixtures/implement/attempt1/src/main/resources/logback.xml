<configuration>
  <!--
    JSON output for production log aggregation (Datadog, ELK, Splunk).
    Every log line is a JSON object; MDC fields (requestId) are included automatically.

    Example output:
      {"@timestamp":"2026-09-29T20:00:00Z","level":"ERROR","logger":"c.e.s.api.ApiExceptionHandler",
       "message":"[P1_CRITICAL] Business failure: CODE_GENERATION_FAILED","requestId":"a1b2-..."}
  -->
  <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeContext>false</includeContext>
      <fieldNames>
        <timestamp>@timestamp</timestamp>
        <version>[ignore]</version>
        <levelValue>[ignore]</levelValue>
      </fieldNames>
    </encoder>
  </appender>

  <!-- Application code: INFO so P1/P2 errors surface and normal request flow is visible. -->
  <logger name="com.example.shortener" level="INFO"/>

  <!-- Suppress Spring Boot startup and framework noise; only errors surface at root. -->
  <root level="WARN">
    <appender-ref ref="JSON"/>
  </root>
</configuration>
